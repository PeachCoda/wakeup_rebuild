[Unit]
Description=FakeUp SKL sign-in proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/var/www/kb.c0d4.ink
ExecStart=/usr/bin/node /var/www/kb.c0d4.ink/server/skl-proxy.mjs
Environment=PORT=8787
Environment=FAKEUP_SKL_DATA_DIR=/var/lib/fakeup-skl
StateDirectory=fakeup-skl
Restart=on-failure
RestartSec=3
User=www-data
Group=www-data
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
